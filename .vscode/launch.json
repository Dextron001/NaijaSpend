{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ Start NaijaSpend (F5)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "running on",
        "uriFormat": "http://localhost:3000",
        "action": "openExternally"
      }
    }
  ]
}
